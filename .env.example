# =============================================================================
# Deployment configuration. Copy to .env.local for development, or set these in
# the Vercel dashboard / docker-compose for production.
#
# EVERY value here is optional — the app boots with none of them set.
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined into the client bundle at BUILD
# time. In Docker they must be passed as build args (see Dockerfile), not just
# at run time. Server-side values below are read at runtime and can be changed
# with a restart.
# =============================================================================

# ---- Identity ---------------------------------------------------------------
# Public origin, used for canonical URLs, OG tags, robots.txt and sitemap.
NEXT_PUBLIC_SITE_URL=https://isharethings.com

# Branding. Change these to rebrand the deployment without touching code.
# Upstream MIT attribution to the IRONSIGHT project is preserved separately in
# src/lib/brand.ts and is intentionally not configurable — do not remove it.
NEXT_PUBLIC_APP_NAME=WATCHFLOOR
NEXT_PUBLIC_APP_SHORT=WATCHFLOOR
NEXT_PUBLIC_APP_TAGLINE=GLOBAL CONFLICT MONITORING // OPEN SOURCE
# NEXT_PUBLIC_APP_DESCRIPTION=
# NEXT_PUBLIC_OPERATOR_NAME=
# NEXT_PUBLIC_OPERATOR_URL=
# NEXT_PUBLIC_CONTACT=abuse@example.com

# Restrict which theaters this deployment exposes. Empty = all registered.
# NEXT_PUBLIC_ENABLED_THEATERS=iran-israel,russia-ukraine

# ---- Security headers -------------------------------------------------------
# enforce | report-only | off. Defaults to enforce in production.
# Use report-only first on a new domain, check the console, then switch.
CSP_MODE=enforce
# Extra hosts to allow in connect-src/img-src (comma separated, with scheme).
# CSP_EXTRA_HOSTS=https://tiles.example.com

# ---- Rate limiting (per IP, applied to /api/*) ------------------------------
# Defaults to on in production. Counters are per process — see the note in
# src/lib/security/rateLimit.ts before relying on this on serverless.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
RATE_LIMIT_EXPENSIVE_MAX=60
# Header order used to resolve the client IP behind your proxy/CDN.
# RATE_LIMIT_IP_HEADERS=x-forwarded-for,x-real-ip,cf-connecting-ip

# ---- Upstream request protection --------------------------------------------
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_FAST_TIMEOUT_MS=3500
UPSTREAM_MAX_BYTES=4000000
UPSTREAM_MAX_CONCURRENT_PER_HOST=4
UPSTREAM_BREAKER_THRESHOLD=5
UPSTREAM_BREAKER_COOLDOWN_MS=60000
# Identify yourself to upstream providers so they can contact you, not just
# block you. Strongly recommended to include a real contact URL in production.
# UPSTREAM_USER_AGENT=WATCHFLOOR/1.0 (+https://isharethings.com/about)

# ---- Server-side cache TTLs -------------------------------------------------
# These decouple visitor count from upstream request count. Raising them is the
# single most effective thing you can do if a provider starts throttling you.
CACHE_TTL_NEWS_MS=90000
CACHE_TTL_TELEGRAM_MS=45000
CACHE_TTL_MARKETS_MS=60000
CACHE_TTL_ALERTS_MS=5000
CACHE_TTL_DEFAULT_MS=60000
# How long stale data may be served after upstream starts failing.
CACHE_STALE_MAX_MS=900000
